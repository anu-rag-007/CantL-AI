{
  "manifest_version": 3,
  "name": "CantL‑AI Fact Checker",
  "description": "One‑click fact‑checking for Instagram, Facebook, and X/Twitter.",
  "version": "1.0.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.twitter.com/*", "*://*.x.com/*"],
      "js": ["content_script.js"]
    }
  ]
}
